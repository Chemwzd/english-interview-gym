# ============================================================
# EngTraining 环境变量模板
# 用法：复制为 app/.env 并填入你自己的密钥：
#     cp app/.env.example app/.env
# 或运行配置助手（交互式输入并在线验证）：
#     python3 scripts/setup_env.py
#
# ⚠️ app/.env 已被 .gitignore 忽略，永不入库；请勿把真实密钥提交到任何仓库。
# ============================================================

# 【必填】API Key —— 对话模型 / 语音识别 / 语音合成 全走这一个 Key
# 自备：在你选用的 OpenAI 兼容服务（官方 API 或聚合网关）处创建
API_KEY=sk-xxxx

# 【可选】接口地址：覆盖 app/config.yaml 里的 llm.base_url
# （语音识别/合成的接口地址单独在 config.yaml 的 asr.endpoint / tts.endpoint 配置）
# API_BASE_URL=https://your-service.example.com/v1
