# ============================================================
# EngTraining 环境变量模板
# 用法：复制为 app/.env 并填入你自己的密钥：
#     cp app/.env.example app/.env   （然后编辑 app/.env）
# 或运行自动生成脚本（会尝试从本机已有配置提取，或提示手动填写）：
#     python3 scripts/setup_env.py
#
# ⚠️ app/.env 已被 .gitignore 忽略，永不入库；请勿把真实密钥提交到任何仓库。
# ============================================================

# 【必填】腾讯云 TokenHub API Key —— LLM / 语音识别 / 语音合成 全走这一个 Key
# 获取：https://console.cloud.tencent.com/tokenhub  → 创建 API Key
# 注：语音模型（ASR/TTS）需在控制台开通"后付费"，否则会返回 402
TOKENHUB_API_KEY=sk-xxxx

# 【可选】TokenHub 接口地址（默认即为下方地址，一般无需修改）
# TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 【可选】腾讯云 API 凭证 —— 仅使用"VOD 生图（题目形象图）"等云功能时需要
# 获取：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_VOD_SUB_APP_ID=
