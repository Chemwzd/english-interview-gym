# ============================================================
# EngTraining 环境变量模板
# 用法：复制为 app/.env 并填入你自己的密钥：
#     cp app/.env.example app/.env
# 或运行配置助手（交互式输入并在线验证）：
#     python3 scripts/setup_env.py
#
# ⚠️ app/.env 已被 .gitignore 忽略，永不入库；请勿把真实密钥提交到任何仓库。
#
# 对话服务与语音服务可以分开用不同服务商（不同 Key）：
#   对话：DeepSeek 官方 / GLM / 任意 OpenAI 兼容服务
#   语音：腾讯云 TokenHub / MiniMax 官方 / 硅基流动 / OpenAI 等
# ============================================================

# 【必填】对话服务 API Key（聊天模型）
API_KEY=sk-xxxx

# 【可选】对话服务接口地址：覆盖 app/config.yaml 里的 llm.base_url
# API_BASE_URL=https://your-service.example.com/v1

# 【可选】语音服务 Key —— 识别 / 合成专用，可与对话 Key 来自不同服务商。
# 不设置时复用上面的 API_KEY（同一家服务商场景直接留空即可）。
# 例：对话用 DeepSeek 官方 + 语音单独买 TokenHub / MiniMax / 硅基流动 → 在这里填语音那家的 Key
# SPEECH_API_KEY=sk-speech-xxxx

# 语音识别 / 合成的接口地址与模型在 app/config.yaml 的 asr.endpoint / tts.endpoint
# （也可在界面「⚙️ 设置 → 🎙️ 语音服务」里填写；端点协议按地址自动识别）
